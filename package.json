{
  "name": "student-hub",
  "version": "1.0.0",
  "description": "Student Hub - Academic Management Platform (Full-Stack Monorepo)",
  "type": "module",
  "main": "server/dist/server.js",
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,magenta\" \"npm run dev --prefix server\" \"npm run dev --prefix client\"",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "build": "npm run build --prefix server && npm run build --prefix client",
    "build:server": "npm run build --prefix server",
    "build:client": "npm run build --prefix client",
    "lint": "eslint \"server/src/**/*.{ts,js}\" \"client/src/**/*.{ts,tsx}\"",
    "lint:fix": "eslint --fix \"server/src/**/*.{ts,js}\" \"client/src/**/*.{ts,tsx}\"",
    "format": "prettier --write \"server/src/**/*.{ts,js}\" \"client/src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"server/src/**/*.{ts,js}\" \"client/src/**/*.{ts,tsx,css}\"",
    "test:server": "npm test --prefix server",
    "test:client": "npm test --prefix client",
    "test": "npm run test:server && npm run test:client && bash scripts/test.sh",
    "test:legacy": "node legacy-archive/test.js"
  },
  "keywords": [
    "student-hub",
    "react",
    "express",
    "typescript",
    "devops"
  ],
  "author": "Abhimanyu Single Rathore",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^9.1.2",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "typescript-eslint": "^8.72.1"
  }
}
