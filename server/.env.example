# Student Hub API Configuration
PORT=5001
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Database configuration (Local MongoDB or Atlas connection)
MONGODB_URI=mongodb://127.0.0.1:27017/student-hub

# Security & Authentication
# JWT_SECRET must be at least 16 characters in length
JWT_SECRET=student_hub_dev_secret_key_minimum_32_bytes_safe_default
JWT_EXPIRES_IN=7d

# Cookie cross-origin configuration:
# - Use 'lax' for local development (http://localhost)
# - Use 'none' for decoupled cloud deployments (e.g. Vercel frontend + Render backend)
# - Use 'strict' only if frontend and API share the exact same first-party domain
COOKIE_SAME_SITE=lax
